import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import sys
import os
from scipy.sparse import csr_matrix
from sklearn.decomposition import TruncatedSVD
from sklearn.neighbors import NearestNeighbors
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import sigmoid_kernel
from sklearn.cluster import KMeans

plt.style.use("ggplot")


def load_product_list():
    products = pd.read_csv("/content/products.csv")
    aisles = pd.read_csv("/content/aisles.csv")
    departments = pd.read_csv("/content/departments.csv")

    merged = products.merge(aisles, on='aisle_id').merge(departments, on='department_id')
    merged = merged.sort_values('product_id')

    return merged.head(1000)


def get_orders_matrix():
    order_products_train = pd.read_csv("dataset/order_products__train.csv")
    products_df = load_product_list()

    orders_products = order_products_train.merge(products_df, on='product_id')
    orders_products.rename(columns={'add_to_cart_order': 'rating'}, inplace=True)
    orders_products = orders_products.dropna(subset=['product_name'])

    ratingCount = (orders_products.groupby(by=['product_name'])['rating'].count()
                   .reset_index().rename(columns={'rating': 'totalRatingCount'}))

    orders_products = orders_products.merge(ratingCount, on='product_name', how='left')

    rating_threshold_min = 0
    rating_threshold_max = 5000

    mask = (orders_products['totalRatingCount'] >= rating_threshold_min) & \
           (orders_products['totalRatingCount'] <= rating_threshold_max)

    rating_popular_products = orders_products.loc[mask]

    orders_products_df = rating_popular_products.pivot_table(
        index='product_name',
        columns='order_id',
        values='rating'
    ).fillna(0)

    return orders_products_df



def run_svd_recommendation():
    print("--- Running SVD (Matrix Factorization) ---")
    amazon_ratings = pd.read_csv('dataset/ratings_Beauty.csv')
    amazon_ratings = amazon_ratings.dropna().head(10000)

    ratings_utility_matrix = amazon_ratings.pivot_table(
        values='Rating',
        index='UserId',
        columns='ProductId',
        fill_value=0
    )

    X = ratings_utility_matrix.T
    SVD = TruncatedSVD(n_components=10)
    decomposed_matrix = SVD.fit_transform(X)
    correlation_matrix = np.corrcoef(decomposed_matrix)

    if not X.index.empty:
        target_product_id = X.index[0]
        product_idx_num = list(X.index).index(target_product_id)
        correlation_product_ID = correlation_matrix[product_idx_num]
        min_confidence = 0.90

        recommendations = list(X.index[correlation_product_ID > min_confidence])
        if target_product_id in recommendations:
            recommendations.remove(target_product_id)

        print(f"SVD Recommendations for {target_product_id}: {recommendations[:9]}")
    else:
        print("Not enough data for SVD.")




def run_knn_recommendation(query_index):
    print("--- Running KNN Collaborative Filtering ---")
    products_df = load_product_list()
    orders_products_df = get_orders_matrix()

    orders_products_df_matrix = csr_matrix(orders_products_df.values)
    model_knn = NearestNeighbors(metric='cosine', algorithm='brute')
    model_knn.fit(orders_products_df_matrix)

    query_vector = orders_products_df.iloc[query_index, :].values.reshape(1, -1)
    distances, indices = model_knn.kneighbors(query_vector, n_neighbors=6)

    reco = []
    for i in range(len(distances.flatten())):
        matrix_idx = indices.flatten()[i]
        product_name = orders_products_df.index[matrix_idx]
        reco.append(product_name)

    reco_df = pd.DataFrame(reco, columns=['product_name'])
    reco_df = reco_df.merge(products_df, on='product_name', how='left')
    print(f"KNN Recommendations:\n{reco_df[['product_name', 'department']]}")
    return reco_df




def run_content_based_recommendation(product_name_query):
    print("--- Running Content-Based Filtering ---")
    products = load_product_list()

    products['description'] = products['aisle'] + ' ' + products['department']
    products['description'] = products['description'].fillna('')

    tfv = TfidfVectorizer(min_df=1, strip_accents='unicode',
                          analyzer='word', token_pattern=r'\w{1,}',
                          ngram_range=(1, 3), stop_words='english')

    tfv_matrix = tfv.fit_transform(products['description'])
    sig = sigmoid_kernel(tfv_matrix, tfv_matrix)

    indices = pd.Series(products.index, index=products['product_name']).drop_duplicates()

    if product_name_query not in indices:
        print(f"Product '{product_name_query}' not found.")
        return

    idx = indices[product_name_query]
    sig_scores = list(enumerate(sig[idx]))
    sig_scores = sorted(sig_scores, key=lambda x: x[1], reverse=True)[1:11]

    product_indices = [i[0] for i in sig_scores]
    recommended_products = products.iloc[product_indices]
    print(f"Content Recommendations for {product_name_query}:\n{recommended_products['product_name']}")
    return recommended_products


# Globals for clustering
cluster_vectorizer = None
cluster_model = None
cluster_data = None



def train_clustering_model():
    print("--- Training K-Means Clustering ---")
    global cluster_vectorizer, cluster_model, cluster_data

    cluster_data = load_product_list()
    cluster_data['text_feature'] = cluster_data['product_name'] + " " + cluster_data['department']

    cluster_vectorizer = TfidfVectorizer(stop_words='english')
    X = cluster_vectorizer.fit_transform(cluster_data['text_feature'])

    true_k = 10
    cluster_model = KMeans(n_clusters=true_k, init='k-means++', max_iter=100, n_init=1)
    cluster_model.fit(X)


def show_recommendations(product_query):
    if cluster_model is None:
        train_clustering_model()

    print(f"--- Cluster Lookup: {product_query} ---")
    Y = cluster_vectorizer.transform([product_query])
    prediction = cluster_model.predict(Y)[0]

    cluster_data['cluster'] = cluster_model.labels_
    similar_items = cluster_data[cluster_data['cluster'] == prediction]['product_name'].head(5).tolist()
    print(f"Cluster ID: {prediction}")
    print(f"Similar items: {similar_items}")


if __name__ == "__main__":
    train_clustering_model()
    show_recommendations("chocolate")
